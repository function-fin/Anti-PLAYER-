    if ConexaoStepped then ConexaoStepped:Disconnect() end
    
    for player, _ in pairs(JogadoresDeletados) do
        limparDadosJogador(player)
        if player.Character then
            player.Character.Parent = workspace
        end
    end
    
    ScreenGui:Destroy()
end)

