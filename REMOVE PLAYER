-- =============================================================================
-- SISTEMA DE ARRASTE (DRAGGING)
-- =============================================================================
local function criarArrastavel(guiObject)
    local dragging, dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

criarArrastavel(MainFrame)
criarArrastavel(ToggleBtn)

-- =============================================================================
-- FILTRAGEM DA LISTA DE BUSCA
-- =============================================================================
local function filtrarEOrdenarLista()
    local filtro = SearchBar.Text:lower()
    for _, btn in ipairs(ScrollList:GetChildren()) do
        if btn:IsA("TextButton") then
            local playerName = btn.Name:lower()
            local displayName = btn:GetAttribute("DisplayName"):lower()
            
            if filtro == "" then
                btn.LayoutOrder = 100
                btn.Visible = true
            else
                local matchUser = string.find(playerName, filtro, 1, true)
                local matchDisplay = string.find(displayName, filtro, 1, true)
                
                if matchUser or matchDisplay then
                    local menorPosicao = math.min(matchUser or 999, matchDisplay or 999)
                    btn.LayoutOrder = menorPosicao
                    btn.Visible = true
                else
                    btn.LayoutOrder = 1000
                    btn.Visible = false
                end
            end
        end
    end
end

SearchBar:GetPropertyChangedSignal("Text"):Connect(filtrarEOrdenarLista)

-- =============================================================================
-- MECÂNICA DE REMOÇÃO LOCAL
-- =============================================================================

local function processarItemDoAlvo(item, player)
    if not item then return end
    
    if item:IsA("Tool") then
        pcall(function() item:Destroy() end)
        return
    end

    local nomeItem = item.Name:lower()
    if string.find(nomeItem, "bola") or string.find(nomeItem, "ball") then
        local ownerAttr = item:GetAttribute("Owner") or item:GetAttribute("Creator")
        if ownerAttr and (tostring(ownerAttr):lower() == player.Name:lower() or ownerAttr == player.UserId) then
            pcall(function() item:Destroy() end)
            return
        end
        
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and item:IsA("BasePart") then
            local distancia = (item.Position - player.Character.HumanoidRootPart.Position).Magnitude
            if distancia < 15 then
                pcall(function() item:Destroy() end)
            end
        end
    end
end

ConexaoDescendantAdded = workspace.DescendantAdded:Connect(function(descendant)
    for player, _ in pairs(JogadoresDeletados) do
        if player.Character and descendant:IsDescendantOf(player.Character) then
            processarItemDoAlvo(descendant, player)
        else
            task.defer(function()
                processarItemDoAlvo(descendant, player)
            end)
        end
    end
end)

ConexaoStepped = RunService.Stepped:Connect(function()
    for player, _ in pairs(JogadoresDeletados) do
        if player.Character then
            player.Character.Parent = nil
        end
    end
end)

local function gerenciarJogadorDeletado(player)
    local dados = JogadoresDeletados[player]
    if dados then
        if player.Character then player.Character.Parent = nil end
        if not dados.ConexaoChar then
            dados.ConexaoChar = player.CharacterAdded:Connect(function(char)
                task.wait()
                if JogadoresDeletados[player] then char.Parent = nil end
            end)
        end
    else
        if player.Character then player.Character.Parent = workspace end
    end
end

local function limparDadosJogador(player)
    if JogadoresDeletados[player] then
        if JogadoresDeletados[player].ConexaoChar then
            JogadoresDeletados[player].ConexaoChar:Disconnect()
        end
        JogadoresDeletados[player] = nil
    end
end

-- =============================================================================
-- GERENCIADOR DA LISTA (Apenas ativa/desativa a Borda Branca)
-- =============================================================================
local function alternarEstadoBotao(player, btn, stroke, forcarEstado)
    local deveAtivar = forcarEstado
    if deveAtivar == nil then
        deveAtivar = not JogadoresDeletados[player]
    end

    if deveAtivar then
        if not JogadoresDeletados[player] then
            JogadoresDeletados[player] = { ConexaoChar = nil }
        end
        gerenciarJogadorDeletado(player)
        
        stroke.Color = Color3.fromRGB(255, 255, 255)
    else
        limparDadosJogador(player)
        gerenciarJogadorDeletado(player)
        
        stroke.Color = Color3.fromRGB(0, 0, 0)
    end
end

local function criarBotaoJogador(player)
    if player == LocalPlayer then return end

    local PlayerBtn = Instance.new("TextButton")
    PlayerBtn.Name = player.Name
    PlayerBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    PlayerBtn.BorderSizePixel = 0
    PlayerBtn.Size = UDim2.new(1, 0, 1, 0)
    
    PlayerBtn.Text = player.DisplayName .. " (@" .. player.Name .. ")"
    PlayerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    PlayerBtn.TextSize = 13 
    PlayerBtn.Font = FONT_ARCADE 
    PlayerBtn.TextTruncate = Enum.TextTruncate.AtEnd
    PlayerBtn.ZIndex = 4 -- Aumentado levemente para sobrepor fundos perfeitamente
    
    PlayerBtn:SetAttribute("DisplayName", player.DisplayName)
    PlayerBtn.Parent = ScrollList

    local BtnBorder = Instance.new("UIStroke")
    BtnBorder.Color = Color3.fromRGB(0, 0, 0)
    BtnBorder.Thickness = 1.5
    BtnBorder.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    BtnBorder.Parent = PlayerBtn

    if ALL_ATIVADO then
        alternarEstadoBotao(player, PlayerBtn, BtnBorder, true)
    end

    PlayerBtn.MouseButton1Click:Connect(function()
        alternarEstadoBotao(player, PlayerBtn, BtnBorder)
    end)
end

-- Funcionalidade do Botão ALL
AllBtn.MouseButton1Click:Connect(function()
    ALL_ATIVADO = not ALL_ATIVADO
    
    if ALL_ATIVADO then
        AllBorder.Color = Color3.fromRGB(255, 255, 255)
    else
        AllBorder.Color = Color3.fromRGB(0, 0, 0)
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local btn = ScrollList:FindFirstChild(p.Name)
            local stroke = btn and btn:FindFirstChildOfClass("UIStroke")
            if btn and stroke then
                alternarEstadoBotao(p, btn, stroke, ALL_ATIVADO)
            end
        end
    end
end)

-- Funcionalidade do Botão X (Destruição Completa)
CloseBtn.MouseButton1Click:Connect(function()
